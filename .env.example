APP_ENV=local
LOG_LEVEL=INFO

# Groq (free) - get a key at console.groq.com
GROQ_API_KEY=
GROQ_MODEL=groq/llama-3.3-70b-versatile

# Pinecone (free tier) - used starting Phase 2
PINECONE_API_KEY=
PINECONE_INDEX_NAME=compliance-agent

# Redis (run free locally via Docker) - used starting Phase 3
REDIS_URL=redis://localhost:6379/0
